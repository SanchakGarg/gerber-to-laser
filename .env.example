# Copy to .env and adjust. docker compose reads .env automatically.

# --- server ---
# Port the app listens on (inside the container and published on the host).
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from another site (empty = same-origin only).
CORS_ORIGINS=

# --- uploads / sessions ---
MAX_UPLOAD_MB=50
MAX_FILES=64
# Parsed boards are kept in memory this long after last use.
SESSION_TTL_MINUTES=60
MAX_SESSIONS=32

# --- geometry ---
# Max chord error when turning arcs/circles into polygons (KiCad plugin uses 0.005).
ARC_TOLERANCE_MM=0.005
# Simplification applied to on-screen previews only (exports are never simplified).
PREVIEW_SIMPLIFY_MM=0.002
# Board thickness used by the 3D view.
BOARD_THICKNESS_MM=1.6

# --- export defaults (the UI can override per export) ---
DEFAULT_DPI=1000
MAX_DPI=2400
DEFAULT_MIRROR_FRONT=false
DEFAULT_MIRROR_BACK=true
# Drill holes/slots are cut this many mm smaller in diameter than their real size (negative = larger).
HOLE_TOLERANCE_MM=0.2
